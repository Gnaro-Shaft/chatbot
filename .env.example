# === Chatbot — Variables d'environnement ===
# Copier en .env et renseigner ta clé Tavily
# Ne jamais commiter .env

# Clé API Tavily — https://tavily.com/
TAVILY_API_KEY=

# Nombre de résultats web à récupérer par recherche
TAVILY_MAX_RESULTS=5

# Profondeur de recherche Tavily : basic | advanced
TAVILY_SEARCH_DEPTH=basic

# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Nombre de tours de conversation à retenir
MEMORY_TURNS=10
